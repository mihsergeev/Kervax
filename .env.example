# --- Required (the panel REFUSES TO START on empty/default secrets) ---

# Admin account: initial login for the panel (JWT + optional 2FA).
# The password here is only the INITIAL one — change it later in the UI, which
# also invalidates old sessions. It is NOT re-synced on restart.
KERVAX_ADMIN_USER=admin
# Set a strong password — at least 12 characters and not "admin"/"changeme".
# A shorter one is refused when the admin account is first created:
KERVAX_ADMIN_PASSWORD=

# JWT signing secret — MUST be 32+ random chars. Generate with:
#   openssl rand -hex 32
# A weak/empty/default value makes admin tokens forgeable, so the panel
# refuses to start unless this is strong.
KERVAX_JWT_SECRET=

# PostgreSQL password (used only inside the compose network). Set any strong
# random value; postgres won't initialise without it.
KERVAX_DB_PASSWORD=

# Break-glass recovery: set to 1 to reset the admin password (to
# KERVAX_ADMIN_PASSWORD) and disable 2FA on next start — use only if you lost
# both the password and 2FA, then set back to 0 and restart. Leave 0 normally.
KERVAX_ADMIN_PASSWORD_RESET=0

# Where the panel is published on the host (standalone / base compose).
# Default binds to localhost — put a reverse proxy with HTTPS in front.
# Set to e.g. 0.0.0.0:8080 to expose on all interfaces (plain HTTP — be careful).
KERVAX_BIND=127.0.0.1:8080

# --- Only for compose.caddy.yml (caddy-docker-proxy edge) ---

# Name of the existing Docker network your caddy-docker-proxy watches.
KERVAX_CADDY_NETWORK=caddy

# Domain served by caddy-docker-proxy (edge TLS)
KERVAX_DOMAIN=kervax.example.com

# Space-separated IPs allowed to reach the panel (edge IP allow-list).
# CAUTION: leaving this EMPTY allows ALL IPs (fail-open) — the panel is then
# guarded only by the login + 2FA. Set your own IP(s) unless that is intended.
KERVAX_ALLOW_IPS=203.0.113.10 198.51.100.23

# --- Secure agent auto-updates (OPTIONAL, off by default) ---

# Leave EMPTY to disable agent self-updates (agents are then updated by re-running
# the install command on each node). To enable signed over-the-air updates, generate
# a keypair (python agent-signing/keygen.py) and paste the PUBLIC key here — it gets
# baked into the agent so it only installs releases you signed offline. See README.
KERVAX_AGENT_PUBKEY=

# --- Optional (defaults shown) ---

# Scheduler tick — how often the background loop checks which monitors are due
# to run, seconds. Keep it <= the smallest monitor interval you use.
KERVAX_SCHEDULER_TICK=30

# PostgreSQL memory sizing (see compose.yml db `command`). Defaults suit ~4 GB of
# RAM shared with the backend. On a bigger / dedicated DB box, raise these:
# shared_buffers ~= 25% of RAM, effective_cache_size ~= 50-75% of RAM.
KERVAX_PG_SHARED_BUFFERS=256MB
KERVAX_PG_EFFECTIVE_CACHE=1536MB

# Number of API/ingest worker processes — ONLY used with compose.scale.yml (which
# also runs the scheduler as its own single process). Keep workers × ~15 DB
# connections under Postgres max_connections=100 (so ~4-6). Ignored otherwise.
KERVAX_WEB_WORKERS=3

# --- SSH layer (secondary: node resources + systemd/disk/command checks) ---

# Public IP of the panel — written into node setup scripts (ufw / hosts.allow)
KERVAX_PANEL_IP=

# Default SSH user prefilled in the "add node" form
KERVAX_DEFAULT_SSH_USER=kervax

# Low-disk alert threshold for monitored nodes, percent (0 = off)
KERVAX_DISK_ALERT_PERCENT=90

# Auto-backup: interval in hours (0 = off) and how many copies to keep
KERVAX_BACKUP_INTERVAL_HOURS=24
KERVAX_BACKUP_KEEP=14
