# Исходник dev-lock: runtime-lock целиком (те же версии, -c) плюс тесты и инструменты CI.
# CI ставит requirements-dev.txt с --require-hashes --no-deps, затем пакет без зависимостей.
# Список тестовых зависимостей повторяет [project.optional-dependencies].dev из pyproject.toml.
# Пересборка: sh backend/lock.sh
-r requirements.in
-c requirements.txt
