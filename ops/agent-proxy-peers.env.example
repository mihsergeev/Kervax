# Root-owned /etc/kervax/agent-proxy-peers.env (mode 0600).
# Use exact com.docker.compose.project/service labels from your deployment.
KERVAX_PROXY_PEERS_PROJECT=kervax
KERVAX_PROXY_PEERS_FRONTEND_SERVICE=frontend
KERVAX_PROXY_PEERS_BACKEND_SERVICE=backend
KERVAX_PROXY_PEERS_CADDY_PROJECT=caddy-proxy
KERVAX_PROXY_PEERS_CADDY_SERVICE=caddy
KERVAX_PROXY_PEERS_EDGE_NETWORK=caddy
KERVAX_PROXY_PEERS_DATA_DIR=/app/kervax/data
