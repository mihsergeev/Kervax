[Unit]
Description=Kervax exact trusted agent proxy peers
# Order after an already queued Docker start. Pulling in a masked Docker unit
# would make systemd fail the timer itself and stop future refreshes.
After=docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/kervax/agent-proxy-peers.env
ExecStart=/usr/bin/python3 /lib65/kervax/agent-proxy-peers-sync.py
TimeoutStartSec=90
UMask=0022
NoNewPrivileges=true
